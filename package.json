{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/prepare-3d.mjs && node scripts/local.mjs dev",
    "build": "node scripts/prepare-3d.mjs && next build --webpack",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node --experimental-strip-types tests/domain.test.mjs && node --experimental-strip-types tests/permissions.test.mjs && node tests/geometry.test.mjs && node --experimental-strip-types tests/tenant-identity.test.mjs",
    "test:tenant": "node --experimental-strip-types tests/tenant-database.test.mjs && node --experimental-strip-types tests/tenant-import.test.mjs && node --experimental-strip-types tests/tenant-cutover.test.mjs",
    "test:backup": "node --experimental-strip-types tests/tenant-backup.test.mjs",
    "test:maintenance": "node --experimental-strip-types tests/tenant-maintenance.test.mjs",
    "test:workspace": "node --experimental-strip-types tests/erp-transport.test.mjs && node --experimental-strip-types tests/company-workspace.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fflate": "0.8.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "manifold-3d": "3.5.3",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "postgres": "3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "three": "0.186.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
